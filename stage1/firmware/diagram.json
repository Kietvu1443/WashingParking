{
  "version": 1,
  "author": "WashingParking stage 1",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-servo", "id": "gate", "top": -130, "left": 160, "attrs": { "horn": "single" } },
    { "type": "wokwi-relay-module", "id": "pump", "top": 40, "left": 180, "attrs": { "transistor": "npn" } },
    { "type": "board-ssd1306", "id": "oled", "top": 150, "left": -170, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 260, "left": -150, "attrs": { "color": "green", "label": "Rua (B)", "key": "b" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "gate:PWM", "esp:18", "orange", [] ],
    [ "gate:V+", "esp:5V", "red", [] ],
    [ "gate:GND", "esp:GND.1", "black", [] ],

    [ "pump:IN", "esp:23", "orange", [] ],
    [ "pump:VCC", "esp:5V", "red", [] ],
    [ "pump:GND", "esp:GND.2", "black", [] ],

    [ "oled:SDA", "esp:21", "green", [] ],
    [ "oled:SCL", "esp:22", "purple", [] ],
    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:GND", "esp:GND.1", "black", [] ],

    [ "btn:1.l", "esp:27", "blue", [] ],
    [ "btn:2.l", "esp:GND.1", "black", [] ]
  ]
}
